# makeshorts — configuração de backends
# Copie para ~/.config/makeshorts/.env (ou .env na raiz do repo) e ajuste.
# Os scripts em scripts/ leem este arquivo. Chaves: NUNCA commitar o .env real.
#
# ── ONDE MUDAR para rodar numa VPS sem GPU / sem inemavox ─────────────────────
#   MS_VOZ         inemavox  → edge | openai | elevenlabs
#   MS_TRANSCRICAO inemavox  → groq | openai
#   MS_IMAGEM      flux-local → nenhuma (usar só b-roll real) | (API de imagem de sua escolha)
# ─────────────────────────────────────────────────────────────────────────────

# ── Voz (narração) ──────────────────────────────────────────────────────────
# inemavox   = TTS local (chatterbox) — precisa GPU + ~/projetos/inemavox
# edge       = Microsoft Edge TTS (grátis, sem chave, sem GPU; serviço online)
# openai     = OpenAI TTS (pago, OPENAI_API_KEY)
# elevenlabs = ElevenLabs (pago, ELEVENLABS_API_KEY; melhor para voz clonada)
MS_VOZ=inemavox
MS_VOZ_IDIOMA=pt
INEMAVOX_DIR=~/projetos/inemavox
# voz clonada: arquivo de referência (rachel = padrão; nei2.wav para a voz do Nei)
INEMAVOX_REF=~/projetos/timesmkt3/media/voice-refs/rachel.wav
EDGE_VOZ=pt-BR-AntonioNeural
OPENAI_TTS_MODELO=gpt-4o-mini-tts
OPENAI_TTS_VOZ=onyx
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODELO=eleven_multilingual_v2

# ── Transcrição (legendas palavra a palavra) ────────────────────────────────
# inemavox = Whisper local (GPU) · groq = Whisper na Groq (barato, rápido) · openai = Whisper OpenAI
MS_TRANSCRICAO=inemavox
GROQ_WHISPER_MODELO=whisper-large-v3-turbo
OPENAI_WHISPER_MODELO=whisper-1

# ── Imagens de apoio (só quando faltar b-roll real) ──────────────────────────
# flux-local = inemaimg/flux2-klein em localhost:8000 (GPU) · nenhuma = não gerar imagem
MS_IMAGEM=flux-local
INEMAIMG_URL=http://localhost:8000

# ── Avatar (opcional, pago) ─────────────────────────────────────────────────
# heygen = skill avatar-heygen-nei / heygen-cli · nenhum = sem avatar
MS_AVATAR=nenhum
HEYGEN_API_KEY=

# ── Publicação ─────────────────────────────────────────────────────────────
# metricool = Metricool MCP conectado no Claude · manual = só gera legenda e arquivo
MS_PUBLICAR=metricool

# ── Chaves (preencha só as dos backends que for usar) ───────────────────────
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=

# ── Saída ──────────────────────────────────────────────────────────────────
MS_SAIDA=~/projetos/output/makeshorts
